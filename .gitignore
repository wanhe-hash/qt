# Qt Creator shadow build directories
# Matches: build-<project>-<kit>-Debug / -Release / etc.
build-*/

# Qt Creator user-specific settings (machine-local, do not commit)
*.user
*.user.*

# Compiled object files
*.o
*.obj

# Generated MOC / qrc / UI files
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h

# Makefiles (qmake-generated)
Makefile
Makefile.*
*.mk
*.makefile

# qmake stash
.qmake.stash

# Misc build noise
*.log
*.tmp
